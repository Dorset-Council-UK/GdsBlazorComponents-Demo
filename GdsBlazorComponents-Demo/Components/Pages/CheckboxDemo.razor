@rendermode InteractiveServer
@page "/checkbox"

<PageTitle>Checkbox - GDS Components Demo</PageTitle>

<GdsBackLink Href="/" />

<GdsHeading Level="1">Checkbox</GdsHeading>

<p class="govuk-body">
    Use the checkbox component to let users select one or more options.
</p>
<GdsWarning Text="You must use the GdsInputCheckbox component within GdsCheckboxItem" />
<p class="govuk-body">
    Even when using a few simple checkboxes they still have to match the GDS design system and accessibility requirements.
    For best accessibility, the recommended structure is form group > fieldset > checkboxes > checkbox item > checkbox input and label.
    The <code>GdsInputCheckbox</code> component has been built in a very flexible way, so the demos below show a few different ways you could use it.
</p>
<p class="govuk-body">
    Also see <GdsLink Href="/checkboxes">GdsCheckboxes</GdsLink> component.
</p>

<GdsHeading Level="2">Example</GdsHeading>

<EditForm Model="@model">
    <GdsFormGroup>
        <GdsFieldsetGroup>
            <GdsCheckboxes>
                <GdsCheckboxItem>
                    <GdsInputCheckbox @bind-Value="model.AcceptTerms" />
                    <GdsCheckboxLabel Text="I accept the terms and conditions 111" />
                    <GdsCheckboxHint>Read the terms before accepting</GdsCheckboxHint>
                </GdsCheckboxItem>
            </GdsCheckboxes>
        </GdsFieldsetGroup>
    </GdsFormGroup>

    <GdsFormGroup>
        <GdsCheckboxItem>
            <GdsInputCheckbox @bind-Value="model.ReceiveEmails" />
            <GdsCheckboxLabel Text="Receive emails 222" />
        </GdsCheckboxItem>
    </GdsFormGroup>
</EditForm>

<div class="govuk-body">
    <div>Terms accepted: @model.AcceptTerms</div>
    <div>Receive emails: @model.ReceiveEmails</div>
</div>

@code {
    private CheckboxModel model = new();

    public class CheckboxModel
    {
        public bool AcceptTerms { get; set; }
        public bool ReceiveEmails { get; set; }
    }
}
