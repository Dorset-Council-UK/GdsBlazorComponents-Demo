@page "/error-summary"
@rendermode InteractiveServer

<PageTitle>Error Summary - GDS Components Demo</PageTitle>

<GdsBackLink Href="/"></GdsBackLink>

<GdsHeading Level="1">Error summary</GdsHeading>

<p class="govuk-body">
    Use the error summary component at the top of a page to summarise any validation errors.
</p>

<GdsHeading Level="2">Example</GdsHeading>

<p class="govuk-body">Submit the form with invalid values to see <GdsLink Href="/error-message">inline error messages</GdsLink> and an error summary</p>

<EditForm EditContext="editContext" OnSubmit="@OnSubmit" FormName="ErrorSummaryExampleForm">
    <DataAnnotationsValidator />
    <GdsErrorSummary />
    
    <GdsFormGroup>
        <GdsLabel Text="What is your full name?" />
        <GdsErrorMessage />
        <GdsInputText @bind-Value="model.FullName" class="govuk-input govuk-input--width-20" />
    </GdsFormGroup>

    <GdsFormGroup>
        <GdsLabel Text="What is your email address?" />
        <GdsErrorMessage />
        <GdsInputText @bind-Value="model.Email" class="govuk-input govuk-input--width-20" />
    </GdsFormGroup>

    <GdsFormGroup>
        <GdsLabel Text="What is your age? (optional)" />
        <GdsErrorMessage />
        <GdsInputNumber @bind-Value="model.AgeText" NumberValue="model.Age" class="govuk-input govuk-input--width-3" />
    </GdsFormGroup>

    <GdsButton IsSubmit PreventDoubleClick Text="Validate" />
</EditForm>

@code {
    private ErrorSummaryModel model = new();
    private EditContext? editContext;

    protected override void OnInitialized()
    {
        model ??= new();
        editContext = new(model);
        editContext.SetFieldCssClassProvider(new GdsFieldCssClassProvider());
    }

    private void OnSubmit()
    {
        editContext?.Validate();
    }

    public class ErrorSummaryModel
    {
        [Required(ErrorMessage = "Enter your full name")]
        [GdsFieldErrorClass(GdsFieldTypes.Input)]
        public string? FullName { get; set; }

        [Required(ErrorMessage = "Enter your email address")]
        [EmailAddress(ErrorMessage = "Enter a valid email address")]
        [GdsFieldErrorClass(GdsFieldTypes.Input)]
        public string? Email { get; set; }

        public string? AgeText{ get; set; }
        public int? Age { get; set; }
    }
}
