@page "/file-input"
@rendermode InteractiveServer

<PageTitle>File Input - GDS Components Demo</PageTitle>

<GdsBackLink Href="/"></GdsBackLink>

<GdsHeading Level="1">File input</GdsHeading>

<p class="govuk-body">
    Use the file upload component to allow users to select and upload files.
</p>

<GdsHeading Level="2">Example</GdsHeading>

<EditForm EditContext="@editContext" OnSubmit="OnSubmit" FormName="FileInputDemo">
    <DataAnnotationsValidator />
    <GdsErrorSummary />

    <GdsFormGroup>
        <GdsLabel Text="Upload supporting documents" />
        <GdsHint>Accepted file types: @_supportedFileTypesString</GdsHint>
        <GdsErrorMessage />
        <GdsFileInput Id="@nameof(model.SupportingDocuments)" OnFilesSubmitted="OnFilesSubmitted" />
    </GdsFormGroup>

    <GdsButton IsSubmit PreventDoubleClick Text="Validate" />
</EditForm>

<div>
    @if(model.SupportingDocuments is not null)
    {
        <ul>
            @foreach (IBrowserFile file in model.SupportingDocuments)
            {
                <li>@file.Name (@FormatFileSize(file.Size))</li>
            }
        </ul>
    }
    else
    {
        <p>No documents uploaded</p>
    }

</div>

@code {
    // Id="supporting-documents"
    private FileInputModel model = new();
    private EditContext editContext = default!;
    private ValidationMessageStore messageStore = default!;

    private string[] _supportedFileTypes = [".pdf", ".docx", ".jpg" ];
    private string _supportedFileTypesString => string.Join(", ", _supportedFileTypes.Select(o => o.TrimStart('.').ToUpperInvariant()).OrderBy(o => o));

    protected override void OnInitialized()
    {
        if (editContext is null)
        {
            editContext = new(model);
            editContext.SetFieldCssClassProvider(new GdsFieldCssClassProvider());
            messageStore = new ValidationMessageStore(editContext);
        }
    }

    private void OnSubmit()
    { 
        messageStore.Clear();
        editContext.Validate();
    }

    private void OnFilesSubmitted(IReadOnlyList<IBrowserFile>? files)
    {
        FieldIdentifier fieldIdentifier = editContext.Field(nameof(model.SupportingDocuments));

        model.SupportingDocuments = files;
        editContext.NotifyFieldChanged(fieldIdentifier);

        if (files is null || files.Count == 0)
        {
            return;
        }

        // check the supported file types
        messageStore.Clear();
        List<string> errors = [];
        foreach (IBrowserFile file in files)
        {
            if (!_supportedFileTypes.Contains(Path.GetExtension(file.Name)))
            {
                errors.Add($"The file '{file.Name}' is not a supported file type.");
            }
        }

        if (errors.Count > 0)
        {
            foreach (string error in errors)
            {
                messageStore.Add(fieldIdentifier, error);
            }
            editContext.NotifyValidationStateChanged();
        }
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    public class FileInputModel
    {
        [Required(ErrorMessage = "Select some files")]
        [GdsFieldErrorClass(GdsFieldTypes.FileUpload)]
        public IReadOnlyList<IBrowserFile>? SupportingDocuments { get; set; }
    }
}
