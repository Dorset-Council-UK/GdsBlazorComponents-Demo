@page "/footer"

<PageTitle>Footer - GDS Components Demo</PageTitle>

<GdsBackLink Href="/"></GdsBackLink>

<GdsHeading Level="1">Footer</GdsHeading>

<p class="govuk-body">
    The footer component provides copyright, licensing and other information about your service.
</p>

<GdsHeading Level="2">Example</GdsHeading>

<div style="padding:10px;border:1px solid black; margin-bottom: 2rem;">
    <GdsFooter>
        <Meta>
        <div class="govuk-footer__meta-item govuk-footer__meta-item--grow">
            <GdsLink class="govuk-footer__link govuk-link-image" Href="https://github.com/Dorset-Council-UK/" title="Go to the Dorset Council GitHub repository">
                <img src="https://gistaticprod.blob.core.windows.net/static/logos/dorset-council/dc_logo_colour_with_clearance.svg" alt="Dorset Council Logo" height="150">
            </GdsLink>
        </div>
        <div class="govuk-footer__meta-item">
            <div>Copyright &copy; @(DateTimeOffset.UtcNow.Year) Dorset Council and other contributors</div>
        </div>
        </Meta>
    </GdsFooter>
</div>

<GdsHeading Level="2">Footer with links</GdsHeading>

<div style="padding:10px;border:1px solid black; margin-bottom: 2rem;">
    <GdsFooter>
        <Meta>
        <div class="govuk-footer__meta-item govuk-footer__meta-item--grow">
            <GdsHeading Level="2" class="govuk-visually-hidden">Support links</GdsHeading>
            <ul class="govuk-footer__inline-list">
                <li class="govuk-footer__inline-list-item">
                    <GdsLink class="govuk-footer__link" Href="#">Item 1</GdsLink>
                </li>
                <li class="govuk-footer__inline-list-item">
                    <GdsLink class="govuk-footer__link" Href="#">Item 2</GdsLink>
                </li>
                <li class="govuk-footer__inline-list-item">
                    <GdsLink class="govuk-footer__link" Href="#">Item 3</GdsLink>
                </li>
            </ul>

            <GdsLink class="govuk-footer__link govuk-link-image" Href="https://github.com/Dorset-Council-UK/" title="Go to the Dorset Council GitHub repository">
                <img src="https://gistaticprod.blob.core.windows.net/static/logos/dorset-council/dc_logo_colour_with_clearance.svg" alt="Dorset Council Logo" height="150">
            </GdsLink>
        </div>
        <div class="govuk-footer__meta-item">
            <div>Copyright &copy; @(DateTimeOffset.UtcNow.Year) Dorset Council and other contributors</div>
        </div>
        </Meta>
    </GdsFooter>
</div>

<GdsHeading Level="2">Footer with secondary navigation</GdsHeading>

<div style="padding:10px;border:1px solid black; margin-bottom: 2rem;">
    <GdsFooter>
        <Navigation>
            <GdsFooterSection Width="GdsGridColumnWidth.TwoThirds">
                <GdsHeading Level="2" Size="GdsSize.Medium" AdditionalCssClasses="govuk-footer__heading">Two column list</GdsHeading>
                <ul class="govuk-footer__list govuk-footer__list--columns-2">
                    <li class="govuk-footer__list-item">
                        <GdsLink class="govuk-footer__link" Href="#">Navigation item 1</GdsLink>
                    </li>
                    <li class="govuk-footer__list-item">
                        <GdsLink class="govuk-footer__link" Href="#">Navigation item 2</GdsLink>
                    </li>
                    <li class="govuk-footer__list-item">
                        <GdsLink class="govuk-footer__link" Href="#">Navigation item 3</GdsLink>
                    </li>
                    <li class="govuk-footer__list-item">
                        <GdsLink class="govuk-footer__link" Href="#">Navigation item 4</GdsLink>
                    </li>
                    <li class="govuk-footer__list-item">
                        <GdsLink class="govuk-footer__link" Href="#">Navigation item 5</GdsLink>
                    </li>
                    <li class="govuk-footer__list-item">
                        <GdsLink class="govuk-footer__link" Href="#">Navigation item 6</GdsLink>
                    </li>
                </ul>
            </GdsFooterSection>
            <GdsFooterSection Width="GdsGridColumnWidth.OneThird">
                <GdsHeading Level="2" Size="GdsSize.Medium" AdditionalCssClasses="govuk-footer__heading">Single column list</GdsHeading>
                <ul class="govuk-footer__list">
                    <li class="govuk-footer__list-item">
                        <GdsLink class="govuk-footer__link" Href="#">Navigation item 1</GdsLink>
                    </li>
                    <li class="govuk-footer__list-item">
                        <GdsLink class="govuk-footer__link" Href="#">Navigation item 2</GdsLink>
                    </li>
                    <li class="govuk-footer__list-item">
                        <GdsLink class="govuk-footer__link" Href="#">Navigation item 3</GdsLink>
                    </li>
                </ul>
            </GdsFooterSection>
        </Navigation>
        <Meta>
        <div class="govuk-footer__meta-item govuk-footer__meta-item--grow">
            <GdsLink class="govuk-footer__link govuk-link-image" Href="https://github.com/Dorset-Council-UK/" title="Go to the Dorset Council GitHub repository">
                <img src="https://gistaticprod.blob.core.windows.net/static/logos/dorset-council/dc_logo_colour_with_clearance.svg" alt="Dorset Council Logo" height="150">
            </GdsLink>
        </div>
        <div class="govuk-footer__meta-item">
            <div>Copyright &copy; @(DateTimeOffset.UtcNow.Year) Dorset Council and other contributors</div>
        </div>
        </Meta>
    </GdsFooter>
</div>

<p class="govuk-body govuk-!-margin-top-6">
    <strong>Note:</strong> The footer in this demo page is shown within a bordered container for demonstration purposes. 
    The actual footer used in this application layout is at the bottom of every page.
</p>
