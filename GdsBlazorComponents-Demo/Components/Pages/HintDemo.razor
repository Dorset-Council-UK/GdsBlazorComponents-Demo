@page "/hint"

<PageTitle>Hint - GDS Components Demo</PageTitle>

<GdsBackLink Href="/"></GdsBackLink>

<GdsHeading Level="1">Hint</GdsHeading>

<p class="govuk-body">
    Use hint text to help users understand what information they need to provide. The hint text normally appears beneath a label and above the input.
</p>

<GdsHeading Level="2">Examples</GdsHeading>

<GdsHeading Level="3">With text input</GdsHeading>
<GdsFormGroup>
    <GdsLabel Text="National Insurance number" />
    <GdsHint>
        It's on your National Insurance card, benefit letter, payslip or P60.
        For example, 'QQ 12 34 56 C'.
    </GdsHint>
    <GdsInputText @bind-Value="model.NiNumber" class="govuk-input govuk-input--width-10" />
</GdsFormGroup>

<GdsHeading Level="3">Standalone hint</GdsHeading>
<GdsHint>
    This is a standalone hint that can be used independently.
</GdsHint>

@code {
    private HintModel model = new();
    private EditContext? editContext;

    protected override void OnInitialized()
    {
        if (editContext is null)
        {
            editContext = new(model);
            editContext.SetFieldCssClassProvider(new GdsFieldCssClassProvider());
        }
    }

    public class HintModel
    {
        [GdsFieldErrorClass(GdsFieldTypes.Input)]
        public string? NiNumber { get; set; }
    }
}