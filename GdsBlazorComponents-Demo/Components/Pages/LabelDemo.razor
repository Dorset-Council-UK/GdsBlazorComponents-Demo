@page "/label"

<PageTitle>Label - GDS Components Demo</PageTitle>

<GdsBackLink Href="/" />

<GdsHeading Level="1">Label</GdsHeading>

<p class="govuk-body">
    Use labels to tell users what information you're asking them to provide.
</p>

<GdsHeading Level="2">Examples</GdsHeading>

<GdsHeading Level="3">Default label</GdsHeading>
<GdsLabel For="first-name" Text="First name" />
<InputText id="first-name" class="govuk-input" @bind-Value="firstName" />

<GdsHeading Level="3" AdditionalCssClasses="govuk-!-margin-top-6">Label with Size</GdsHeading>
<GdsLabel For="more-detail" Text="Can you provide more detail?" Size="GdsSize.Large" />
<textarea class="govuk-textarea" id="more-detail" name="moreDetail" rows="5"></textarea>

@code{
    string firstName = "";
}