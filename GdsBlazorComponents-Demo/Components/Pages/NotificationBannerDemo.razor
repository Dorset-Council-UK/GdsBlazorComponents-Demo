@page "/notification-banner"

<PageTitle>Notification Banner - GDS Components Demo</PageTitle>

<GdsBackLink Href="/"></GdsBackLink>

<GdsHeading Level="1">Notification Banner</GdsHeading>

<p class="govuk-body">
    Use a notification banner to tell the user about something they need to know about, but that's not directly related to the page content.
</p>

<GdsHeading Level="2">Examples</GdsHeading>

<GdsHeading Level="3">Default banner</GdsHeading>
<GdsNotificationBanner BannerTitle="Important">
    <p>
        You have 7 days left to send your application.
        <a class="govuk-notification-banner__link" href="#">View application</a>.
    </p>
</GdsNotificationBanner>

<GdsHeading Level="3">Banner with h2 heading and h3 inside content</GdsHeading>
<GdsNotificationBanner BannerTitle="Success" BannerTitleSize="GdsNotificationBanner.BannerSizeOption.large">
    <h3>
        Training session scheduled
    </h3>
    <p class="govuk-body">We have scheduled your training session for 15 December 2024.</p>
</GdsNotificationBanner>
