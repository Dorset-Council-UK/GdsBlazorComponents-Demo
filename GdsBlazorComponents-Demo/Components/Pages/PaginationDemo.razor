@rendermode InteractiveServer
@page "/pagination"

<PageTitle>Pagination - GDS Components Demo</PageTitle>

<GdsBackLink Href="/" />

<GdsHeading Level="1">Pagination</GdsHeading>

<p class="govuk-body">
    The pagination component helps users navigate forwards and backwards through a series of pages.
</p>

@if (_model is not null)
{
    <GdsGridRow>
        <GdsGridColumn Width="GdsGridColumnWidth.TwoThirds">
            <GdsHeading Level="2">Example</GdsHeading>

            <div class="govuk-body">
                <div>Current page: @_model.CurrentPage</div>
                <div>Total pages: @_model.TotalPages</div>
            </div>

            <GdsPagination CurrentPage="@_model.CurrentPage"
                           TotalPages="@_model.TotalPages"
                           HrefGenerator="@(pageNumber => NavigationManager.Uri)"
                           OnPageChanged="@OnPageChanged"
                           PreviousLabel="@_previousLabel"
                           NextLabel="@_nextLabel"
                           BlockStyle="@_model.UseBlockStyle" />
        </GdsGridColumn>

        <GdsGridColumn Width="GdsGridColumnWidth.OneThird">
            <EditForm EditContext="@_editContext" FormName="pagination">
                <GdsFormGroup>
                    <GdsFieldsetGroup LegendTextSize="GdsSize.Medium">
                        <GdsFieldsetLegend>
                            <GdsFieldsetHeading Level="2">Options</GdsFieldsetHeading>
                        </GdsFieldsetLegend>

                        <GdsErrorMessage />

                        <GdsCheckboxes Smaller>
                            <GdsCheckboxItem>
                                <GdsInputCheckbox @bind-Value="@_model.UseBlockStyle" OnChanged="UpdateLabels" />
                                <GdsCheckboxLabel Text="Block style" />
                            </GdsCheckboxItem>
                            <GdsCheckboxItem>
                                <GdsInputCheckbox @bind-Value="@_model.UseLabels" OnChanged="UpdateLabels" />
                                <GdsCheckboxLabel Text="Use labels" />
                                <GdsCheckboxHint>with block style</GdsCheckboxHint>
                            </GdsCheckboxItem>
                        </GdsCheckboxes>
                    </GdsFieldsetGroup>
                </GdsFormGroup>

                <GdsFormGroup>
                    <GdsLabel Text="Total pages" />
                    <GdsErrorMessage />
                    <GdsSelect T="int" @bind-Value="_model.TotalPages" @bind-Value:after="OnTotalPagesChanged" >
                        <option value="3" selected="@(_model.TotalPages == 3)">3</option>
                        <option value="5" selected="@(_model.TotalPages == 5)">5</option>
                        <option value="10" selected="@(_model.TotalPages == 10)">10</option>
                        <option value="20" selected="@(_model.TotalPages == 20)">20</option>
                        <option value="42" selected="@(_model.TotalPages == 42)">42</option>
                        <option value="50" selected="@(_model.TotalPages == 50)">50</option>
                        <option value="100" selected="@(_model.TotalPages == 100)">100</option>
                    </GdsSelect>
                </GdsFormGroup>
            </EditForm>
        </GdsGridColumn>
    </GdsGridRow>
}

@code {
    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private PaginationDemoModel? _model;
    private EditContext? _editContext;
    private string? _previousLabel;
    private string? _nextLabel;

    protected override void OnInitialized()
    {
        if (_model is null)
        {
            _model = new()
            {
                CurrentPage = 7,
                TotalPages = 42,

                // options
                UseBlockStyle = false,
                UseLabels = true,
            };
            _editContext = new(_model);
            _editContext.SetFieldCssClassProvider(new GdsFieldCssClassProvider());

            UpdateLabels();
        }
    }

    private Task OnPageChanged(int pageNumber)
    {
        if (_model is not null)
        {
            _model.CurrentPage = pageNumber;
            // Search your API for new results ...
        }
        UpdateLabels();

        return Task.CompletedTask;
    }

    private Task OnTotalPagesChanged()
    {
        if (_model is not null)
        {
            if (_model.CurrentPage > _model.TotalPages)
            {
                _model.CurrentPage = _model.TotalPages;
            }
        }
        UpdateLabels();

        return Task.CompletedTask;
    }

    private void UpdateLabels()
    {
        if (_model is not null && _model.UseBlockStyle && _model.UseLabels)
        {
            _previousLabel = $"A previous page (go to page {_model.CurrentPage - 1})";
            _nextLabel = $"A next page (go to page {_model.CurrentPage + 1})";
        }
        else
        {
            _previousLabel = null;
            _nextLabel = null;
        }
    }

    private class PaginationDemoModel
    {
        [GdsFieldErrorClass(GdsFieldTypes.Input)]
        public int CurrentPage { get; set; }

        [GdsFieldErrorClass(GdsFieldTypes.Select)]
        public int TotalPages { get; set; }

        [GdsFieldErrorClass(GdsFieldTypes.Checkbox)]
        public bool UseBlockStyle { get; set; }

        [GdsFieldErrorClass(GdsFieldTypes.Checkbox)]
        public bool UseLabels { get; set; }
    }
}
