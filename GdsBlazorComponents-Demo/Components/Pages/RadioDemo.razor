@page "/radio"
@rendermode InteractiveServer

<PageTitle>Radio - GDS Components Demo</PageTitle>

<GdsBackLink Href="/" />

<GdsHeading Level="1">Radio</GdsHeading>

<p class="govuk-body">
    Individual radio button component. Usually used within a GdsRadios component.
</p>

<GdsHeading Level="2">Example</GdsHeading>

<EditForm EditContext="@editContext" OnValidSubmit="@OnSubmit" FormName="RadioDemo">
    <DataAnnotationsValidator />
    <GdsErrorSummary />

    <GdsFormGroup>
        <GdsFieldsetGroup>
            <GdsFieldsetLegend>
                <GdsFieldsetHeading Level="2">Do you agree?</GdsFieldsetHeading>
            </GdsFieldsetLegend>

            <GdsRadios @bind-Value="model.Agreement">
                <GdsRadioItem>
                    <GdsInputRadio Value="@("yes")" />
                    <GdsRadioLabel Text="Yes, I agree" />
                </GdsRadioItem>
                <GdsRadioItem>
                    <GdsInputRadio Value="@("no")" />
                    <GdsRadioLabel Text="No, I don't agree" />
                </GdsRadioItem>
            </GdsRadios>
        </GdsFieldsetGroup>
    </GdsFormGroup>

    <GdsButton IsSubmit PreventDoubleClick Text="Validate" />
</EditForm>

@if (submitted)
{
    <div class="govuk-!-margin-top-6">
        <GdsHeading Level="3">Form Submitted</GdsHeading>
        <p class="govuk-body">Agreement: @model.Agreement</p>
    </div>
}

@code {
    private RadioModel model = new();
    private EditContext? editContext;
    private bool submitted = false;

    protected override void OnInitialized()
    {
        if (editContext is null)
        {
            editContext = new(model);
            editContext.SetFieldCssClassProvider(new GdsFieldCssClassProvider());
        }
    }

    private void OnSubmit()
    {
        submitted = true;
        editContext?.Validate();
    }

    public class RadioModel
    {
        [Required(ErrorMessage = "Select where you live")]
        [GdsFieldErrorClass(GdsFieldTypes.Radio)]
        public string? Agreement { get; set; }
    }
}
