@rendermode InteractiveServer
@page "/select"

<PageTitle>Select - GDS Components Demo</PageTitle>

<GdsBackLink Href="/"></GdsBackLink>

<GdsHeading Level="1">Select</GdsHeading>

<p class="govuk-body">
    This component allows you to add select elements to any part of your Blazor application using the GDS recommendations.
</p>

<GdsHeading Level="2">Examples</GdsHeading>

<EditForm EditContext="@editContext" OnSubmit="OnSubmit" FormName="SelectDemo">
    <GdsHeading Level="3">Using a dictionary</GdsHeading>

    <details class="govuk-details">
        <summary class="govuk-details__summary">
            <span class="govuk-details__summary-text">
                View code example
            </span>
        </summary>
        <pre><code>@SelectDictCodeExample</code></pre>
    </details>

    <GdsFormGroup For="() => model.SelectedContactType">
        <GdsLabel Text="Contact type" />
        <GdsHint>Select the contact type</GdsHint>
        <GdsErrorMessage />
        <GdsSelect @bind-Value="model.SelectedContactType" T="int">
            @foreach(var value in ContactTypes)
            {
                <option value="@value.Key">@value.Value</option>
            }
        </GdsSelect>
        <p>Selected Value: @model.SelectedContactType</p>
    </GdsFormGroup>

    <GdsHeading Level="3">Using an enum</GdsHeading>

    <details class="govuk-details">
        <summary class="govuk-details__summary">
            <span class="govuk-details__summary-text">
                View code example
            </span>
        </summary>
        <pre><code>@SelectEnumCodeExample</code></pre>
    </details>

    <GdsFormGroup For="() => model.SelectedContactTypeEnum">
        <GdsLabel Text="Contact type" />
        <GdsHint>Select the contact type</GdsHint>
        <GdsErrorMessage />
        <GdsSelect @bind-Value="model.SelectedContactTypeEnum" T="ContactTypeEnum">
            @foreach (var value in Enum.GetValues(typeof(ContactTypeEnum)))
            {
                <option value="@value">@value</option>
            }
        </GdsSelect>
        <p>Selected Value: @model.SelectedContactTypeEnum</p>
    </GdsFormGroup>
</EditForm>

@code {
    private string SelectDictCodeExample = """
        <GdsFormGroup For="() => model.SelectedContactType">
            <GdsLabel Text="Contact type" />
            <GdsHint>Select the contact type</GdsHint>
            <GdsErrorMessage />
            <GdsSelect @bind-Value="model.SelectedContactType" T="int">
                @foreach(var value in ContactTypes)
                {
                    <option value="@value.Key">@value.Value</option>
                }
            </GdsSelect>
            <p>Selected Value: @model.SelectedContactType</p>
        </GdsFormGroup>

        @code {
            private Dictionary<int, string> ContactTypes = new Dictionary<int, string>
            {
                { 0, "None" },
                { 1, "Phone" },
                { 2, "Email" },
                { 3, "Text" },
                { 4, "Post" }
            };

            private SelectModel model = new();
            private EditContext? editContext;

            protected override void OnInitialized()
            {
                if (editContext is null)
                {
                    editContext = new(model);
                    editContext.SetFieldCssClassProvider(new GdsFieldCssClassProvider());
                }
            }

            public class SelectModel
            {
                [GdsFieldErrorClass(GdsFieldTypes.Select)]
                public int SelectedContactType { get; set; } = 1;
            }
        }
        """;

    private string SelectEnumCodeExample = """
        <GdsFormGroup For="() => model.SelectedContactTypeEnum">
            <GdsLabel Text="Contact type" />
            <GdsHint>Select the contact type</GdsHint>
            <GdsErrorMessage />
            <GdsSelect @bind-Value="model.SelectedContactTypeEnum" T="ContactTypeEnum">
                @foreach (var value in Enum.GetValues(typeof(ContactTypeEnum)))
                {
                    <option value="@value">@value</option>
                }
            </GdsSelect>
            <p>Selected Value: @model.SelectedContactTypeEnum</p>
        </GdsFormGroup>

        @code {
            public enum ContactTypeEnum    
            {
                None,
                Phone,
                Email,
                Text,
                Post
            };

            private SelectModel model = new();
            private EditContext? editContext;

            protected override void OnInitialized()
            {
                if (editContext is null)
                {
                    editContext = new(model);
                    editContext.SetFieldCssClassProvider(new GdsFieldCssClassProvider());
                }
            }

            public class SelectModel
            {
                [GdsFieldErrorClass(GdsFieldTypes.Select)]
                public ContactTypeEnum SelectedContactTypeEnum { get; set; } = ContactTypeEnum.Text;
            }
        }
        """;

    private Dictionary<int, string> ContactTypes = new Dictionary<int, string>
    {
        { 0, "None" },
        { 1, "Phone" },
        { 2, "Email" },
        { 3, "Text" },
        { 4, "Post" }
    };

    public enum ContactTypeEnum    
    {
        None,
        Phone,
        Email,
        Text,
        Post
    };

    private SelectModel model = new();
    private EditContext? editContext;

    protected override void OnInitialized()
    {
        if (editContext is null)
        {
            editContext = new(model);
            editContext.SetFieldCssClassProvider(new GdsFieldCssClassProvider());
        }
    }

    private void OnSubmit()
    {
        editContext?.Validate();
    }

    public class SelectModel
    {
        [GdsFieldErrorClass(GdsFieldTypes.Select)]
        public int SelectedContactType { get; set; } = 1;
        
        [GdsFieldErrorClass(GdsFieldTypes.Select)]
        public ContactTypeEnum SelectedContactTypeEnum { get; set; } = ContactTypeEnum.Text;
    }
}