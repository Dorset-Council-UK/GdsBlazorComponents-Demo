@page "/summary-card"

<PageTitle>Summary card - GDS Components Demo</PageTitle>

<GdsBackLink Href="/" />

<GdsHeading Level="1">Summary card</GdsHeading>

<p class="govuk-body">
    This component allows you to show summary lists as a summary card.
    This lets you visually separate each summary list and give each a title and some actions.
</p>

<p class="govuk-body">
    See the <GdsLink Href="/summary-list">summary list component</GdsLink> for information on how to use that component.
</p>

<GdsHeading Level="2">Example</GdsHeading>

<GdsSummaryCard>
    <GdsSummaryCardTitleWrapper>
        <GdsSummaryCardTitle Level="2" Size="GdsSize.Large">Lead tenant</GdsSummaryCardTitle>
    </GdsSummaryCardTitleWrapper>
    <GdsSummaryCardContent>
        <GdsSummaryList>
            <GdsSummaryListRow>
                <GdsSummaryListKey>Age</GdsSummaryListKey>
                <GdsSummaryListValue>38</GdsSummaryListValue>
                <GdsSummaryListActions>
                    <GdsLink Href="@NavigationManager.Uri">Change<span class="govuk-visually-hidden"> age (Lead tenant)</span></GdsLink>
                </GdsSummaryListActions>
            </GdsSummaryListRow>
            <GdsSummaryListRow>
                <GdsSummaryListKey>Nationality</GdsSummaryListKey>
                <GdsSummaryListValue>UK national resident in UK</GdsSummaryListValue>
                <GdsSummaryListActions>
                    <GdsLink Href="@NavigationManager.Uri">Change<span class="govuk-visually-hidden"> nationality (Lead tenant)</span></GdsLink>
                </GdsSummaryListActions>
            </GdsSummaryListRow>
            <GdsSummaryListRow>
                <GdsSummaryListKey>Working situation</GdsSummaryListKey>
                <GdsSummaryListValue>Part time – less than 30 hours a week</GdsSummaryListValue>
                <GdsSummaryListActions>
                    <GdsLink Href="@NavigationManager.Uri">Change<span class="govuk-visually-hidden"> working situation (Lead tenant)</span></GdsLink>
                </GdsSummaryListActions>
            </GdsSummaryListRow>
        </GdsSummaryList>
    </GdsSummaryCardContent>
</GdsSummaryCard>


<GdsHeading Level="2">Example card with actions</GdsHeading>

<GdsSummaryCard>
    <GdsSummaryCardTitleWrapper>
        <GdsSummaryCardTitle Level="2" Size="GdsSize.Large">University of Gloucestershire</GdsSummaryCardTitle>
        <GdsSummaryCardActions>
            <GdsSummaryCardAction>
                <GdsLink Href="@NavigationManager.Uri">Delete choice<span class="govuk-visually-hidden"> (University of Gloucestershire)</span></GdsLink>
            </GdsSummaryCardAction>
            <GdsSummaryCardAction>
                <GdsLink Href="@NavigationManager.Uri">Withdraw<span class="govuk-visually-hidden"> (University of Gloucestershire)</span></GdsLink>
            </GdsSummaryCardAction>
        </GdsSummaryCardActions>
    </GdsSummaryCardTitleWrapper>
    <GdsSummaryCardContent>
        <GdsSummaryList>
            <GdsSummaryListRow>
                <GdsSummaryListKey>Course</GdsSummaryListKey>
                <GdsSummaryListValue>English (3DMD)<br>PGCE with QTS full time</GdsSummaryListValue>
            </GdsSummaryListRow>
            <GdsSummaryListRow>
                <GdsSummaryListKey>Location</GdsSummaryListKey>
                <GdsSummaryListValue>School name<br>Road, City, SW1 1AA</GdsSummaryListValue>
            </GdsSummaryListRow>
        </GdsSummaryList>
    </GdsSummaryCardContent>
</GdsSummaryCard>

@code {
    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
}
